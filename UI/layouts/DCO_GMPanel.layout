    OverlayWidgetClass "{0DC00000000A7750}" {
     Name "DCO_ArsHintBox"
     Slot FrameWidgetSlot "{0DC00000000A7751}" {
      Anchor 0.52 0.55 0.78 0.935
     }
     {
      ImageWidgetClass "{0DC00000000A7752}" {
       Name "DCO_ArsHintBg"
       Slot OverlayWidgetSlot "{0DC00000000A7753}" {
        HorizontalAlign 3
        VerticalAlign 3
       }
       Color 0.043 0.050 0.063 0.95
      }
      VerticalLayoutWidgetClass "{0DC00000000A7754}" {
       Name "DCO_ArsHintVBox"
       Slot OverlayWidgetSlot "{0DC00000000A7755}" {
        HorizontalAlign 3
        VerticalAlign 0
       }
       {
        TextWidgetClass "{0DC00000000A7756}" {
         Name "DCO_ArsHintTitle"
         Slot LayoutSlot "{0DC00000000A7757}" {
          Padding 10 6 10 2
         }
         Text "HOW THE ARSENAL WORKS"
         Color 0.851 0.537 0.169 1
         "Font Size" 21
        }
        ImageWidgetClass "{0DC00000000A7758}" {
         Slot LayoutSlot "{0DC00000000A7759}" {
          Padding 8 0 8 3
         }
         Color 0.851 0.537 0.169 0.30
         Size 300 1
        }
        TextWidgetClass "{0DC00000000A775A}" {
         Slot LayoutSlot "{0DC00000000A775B}" {
          Padding 10 2 10 1
         }
         Text "LEFT: gear by category - click to equip (swaps that slot)."
         Color 0.80 0.84 0.88 1
         "Font Size" 19
        }
        TextWidgetClass "{0DC00000000A775C}" {
         Slot LayoutSlot "{0DC00000000A775D}" {
          Padding 10 2 10 1
         }
         Text "RIGHT: ammo + items - click to add. The crate icon = EVERYTHING CARRIED (click +1, trash removes)."
         Color 0.80 0.84 0.88 1
         "Font Size" 19
        }
        TextWidgetClass "{0DC00000000A775E}" {
         Slot LayoutSlot "{0DC00000000A775F}" {
          Padding 10 2 10 1
         }
         Text "Pick a WEAPON category on the left: the right side becomes ONLY what that weapon accepts."
         Color 0.80 0.84 0.88 1
         "Font Size" 19
        }
        TextWidgetClass "{0DC00000000A7760}" {
         Slot LayoutSlot "{0DC00000000A7761}" {
          Padding 10 2 10 1
         }
         Text "Pick UNIFORM/VEST/BACKPACK: the right side becomes items to put INSIDE the equipped one."
         Color 0.80 0.84 0.88 1
         "Font Size" 19
        }
        TextWidgetClass "{0DC00000000A7762}" {
         Slot LayoutSlot "{0DC00000000A7763}" {
          Padding 10 2 10 1
         }
         Text "A right-side tab (or < ALL ITEMS) returns to the full AMMO + ITEMS pool."
         Color 0.80 0.84 0.88 1
         "Font Size" 19
        }
        TextWidgetClass "{0DC00000000A7764}" {
         Slot LayoutSlot "{0DC00000000A7765}" {
          Padding 10 2 10 1
         }
         Text "CLEAR CAT empties the active category. RESET restores the kit from when editing began."
         Color 0.80 0.84 0.88 1
         "Font Size" 19
        }
        TextWidgetClass "{0DC00000000A7766}" {
         Slot LayoutSlot "{0DC00000000A7767}" {
          Padding 10 2 10 6
         }
         Text "LOADOUTS saves and loads named kits. Red rows = content missing on this server."
         Color 0.80 0.84 0.88 1
         "Font Size" 19
        }
       }
      }
     }
    }
