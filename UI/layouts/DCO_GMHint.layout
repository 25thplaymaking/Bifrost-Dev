FrameWidgetClass {
 Name "BifrostGMHint"
 Slot FrameWidgetSlot { Anchor 1 0.15 1 0.15 }
 {
  OverlayWidgetClass {
   Slot FrameWidgetSlot { Anchor 0 0 1 1 }
   {
    ImageWidgetClass { Color 0.025 0.04 0.05 0.88 Slot OverlayWidgetSlot { HorizontalAlign 3 VerticalAlign 3 } }
    VerticalLayoutWidgetClass {
     Name "Content"
     Slot OverlayWidgetSlot { HorizontalAlign 3 VerticalAlign 0 Padding 18 14 18 16 }
     {
      TextWidgetClass { Name "Title" Text "Game Master" Color 0.42 0.75 0.79 1 "Font Size" 18 Wrap 1 Slot LayoutSlot { HorizontalAlign 3 Padding 0 0 0 7 } }
      TextWidgetClass { Name "Message" Text "" Color 0.93 0.95 0.96 1 "Font Size" 16 Wrap 1 Slot LayoutSlot { HorizontalAlign 3 } }
     }
    }
   }
  }
 }
}
